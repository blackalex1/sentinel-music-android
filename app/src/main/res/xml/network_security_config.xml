<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Запрет открытого текста и доверие только системным центрам сертификации в релизе -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Поддержка пользовательских сертификатов и отладки исключительно в debug сборках -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
