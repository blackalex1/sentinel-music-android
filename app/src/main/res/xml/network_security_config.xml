<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Разрешаем незашифрованный HTTP трафик только для локальной сети и loopback адресов -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Android Emulator host loopback -->
    </domain-config>

    <!-- По умолчанию запрещаем открытый незашифрованный HTTP для любых внешних доменов в сети Интернет -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
